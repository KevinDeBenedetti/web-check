# ==============================================================================
# Web-Check — environment variables
# Copy this file to .env and fill in your values. Reference: docs/configuration.md
# ==============================================================================

# ── Required ───────────────────────────────────────────────────────────────
# Key for the internal ZAP daemon API — `docker compose` refuses to start without it.
# Generate with: openssl rand -hex 32
ZAP_API_KEY=

# Every API scan target must be one of these domains (or a subdomain of one).
# Comma-separated. Also used by the web-check CLI as default targets.
ALLOWED_DOMAINS="example.com"

# ── API server ─────────────────────────────────────────────────────────────
API_PORT=8000                          # Host port of the API (container port is always 8000)
API_BIND=127.0.0.1                     # Host interface; only use 0.0.0.0 with API_KEY set
# Shared secret required in the X-API-Key header (blank = no auth, localhost only!)
API_KEY=
# Comma-separated allowed CORS origins (blank = CORS disabled)
CORS_ORIGINS=
# Allow targets that resolve to private/loopback IPs and single-label hosts (lab use only)
ALLOW_PRIVATE_TARGETS=false
DEBUG=false
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── API container (set automatically by `make start` / `make dev`) ─────────
# Linux: your `id -u` / `id -g`, so ./outputs and ./data stay writable.
# APP_UID=1000
# APP_GID=1000
# Group owning /var/run/docker.sock in the container (`stat -c %g /var/run/docker.sock`;
# 0 on Docker Desktop for macOS).
# DOCKER_GID=999

# ── Storage / network ──────────────────────────────────────────────────────
DOCKER_NETWORK=scanner-net             # Docker network shared with the scanner containers
# SQLite file for local (non-Docker) runs; migrated with Alembic on startup.
# The container always uses data/web-check.db (bind-mounted from ./data).
# DATABASE_PATH=data/web-check.db

# ── web-check CLI (client of the API) ──────────────────────────────────────
WEB_CHECK_CLI_API_URL=http://localhost:8000  # Must match API_PORT
WEB_CHECK_CLI_API_KEY=                 # Same value as API_KEY

# ── my-check CLI (standalone scanner) ──────────────────────────────────────
MY_CHECK_WEB_TARGET=https://example.com   # Default URL for web scans

# Run `kubectl config get-contexts` to list available contexts.
MY_CHECK_K8S_CONTEXT=                  # e.g. k3s, kind-local, my-cluster
MY_CHECK_K8S_KUBECONFIG=               # Absolute path (blank = ~/.kube/config)
MY_CHECK_K8S_SERVER=                   # Override the API server URL, e.g. https://192.168.1.10:6443
MY_CHECK_K8S_NAMESPACE=                # Blank = all namespaces

MY_CHECK_OUTPUT=terminal               # terminal | json | html | webhook
MY_CHECK_OUTPUT_DIR=outputs
MY_CHECK_SARIF=false                   # Emit SARIF 2.1 alongside JSON output
MY_CHECK_WEBHOOK_URL=                  # Slack incoming webhook or custom URL
